APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:j0buU5hTZYB/74jvZb90jA/vGZKDMysoPw8v2WQvF9U=
APP_DEBUG=true
APP_URL=http://192.168.254.105:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=new-moonfinal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Where the Reverb server LISTENS (used only by the websocket service).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# The public URL clients connect to (used by the API service and the web app).
# In production this must be the Reverb service's public https origin.
REVERB_HOST=newmoon-reverb.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https

# Credentials shared between the API and the Reverb service.
# Generate a real secret; never commit one.
REVERB_APP_ID=newmoon-app
REVERB_APP_KEY=newmoon-app-key
REVERB_APP_SECRET=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=

MAIL_FROM_NAME="NewMoon Lechon Manok & Liempo House"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
