# syntax=docker/dockerfile:1
# ----------------------------------------------------
# NewMoon WebSockets — Laravel Reverb server
# ----------------------------------------------------
# Runs the Reverb websocket server as a long-lived foreground
# process. Shares the Backend codebase so that broadcasting
# config and channel authorization match the API service.
# ----------------------------------------------------

# ----------------------------------------------------
# Stage 1: Install PHP dependencies with Composer
# ----------------------------------------------------
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-scripts \
    --optimize-autoloader

# ----------------------------------------------------
# Stage 2: Production PHP 8.3 CLI
# ----------------------------------------------------
FROM php:8.3-cli

WORKDIR /var/www/html

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libonig-dev \
    libicu-dev \
    libpq-dev \
    zip \
    unzip \
    curl \
    ca-certificates \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
    pdo_mysql \
    pdo_pgsql \
    mbstring \
    exif \
    pcntl \
    posix \
    bcmath \
    gd \
    zip \
    intl \
    opcache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Container init wrapper: prepares writable dirs, seeds a .env if the
# platform injects env vars directly, then hands off to Reverb.
COPY docker-entrypoint-reverb.sh /usr/local/bin/docker-entrypoint-reverb.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-reverb.sh

COPY . /var/www/html

COPY --from=vendor /app/vendor /var/www/html/vendor

RUN php artisan package:discover --ansi || true \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

# Render injects PORT; Reverb must bind 0.0.0.0 on that port.
ENV REVERB_SERVER_HOST=0.0.0.0

EXPOSE 8080

ENTRYPOINT ["docker-entrypoint-reverb.sh"]
