# Environment variables for Newmoon-Mobile
# On Render (Static Site), configure these under Environment Variables:

# Live Backend URL on Render (no trailing slash)
EXPO_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Or full API base URL
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Reverb / Pusher WebSocket (if using live Reverb)
EXPO_PUBLIC_REVERB_HOST=your-backend.onrender.com
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_KEY=newmoon-app-key
