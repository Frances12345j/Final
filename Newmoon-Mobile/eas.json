{
  "cli": {
    "version": ">= 18.13.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://nmlmlh5.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://newmoon-reverb.onrender.com",
        "EXPO_PUBLIC_REVERB_KEY": "newmoon-app-key"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://nmlmlh5.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://newmoon-reverb.onrender.com",
        "EXPO_PUBLIC_REVERB_KEY": "newmoon-app-key"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
