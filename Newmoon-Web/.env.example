# Base URL of the Laravel API. Leave as "/api" for local dev (Vite proxies it
# to DEV_API_TARGET) or set a full origin for production builds.
VITE_API_BASE_URL=/api

# Origin of the Laravel API, used to derive the Echo auth endpoint.
# Defaults to the origin of VITE_API_BASE_URL.
# VITE_API_ORIGIN=https://api.newmoon.app

# Laravel Reverb (websockets) connection.
VITE_WS_HOST=localhost
VITE_WS_PORT=8080
# Set to "true" in production to force wss:// on port 443. When omitted, TLS is
# enabled automatically whenever the page is served over https.
# VITE_WS_FORCE_TLS=true
VITE_REVERB_KEY=newmoon-app-key

# Dev-only: where `npm run dev` proxies /api, /broadcasting and /storage.
DEV_API_TARGET=http://localhost:8000

# Dev-only: interface the Vite dev server binds to. Set to the single address
# your phone uses so Vite prints one "Network:" line instead of one per network
# adapter. Leave unset to bind loopback only (no LAN access).
# DEV_HOST=192.168.1.10

# Public path the built app is served from. Only needed for a subdirectory
# deploy; the dev server and root-domain deploy use "/".
# VITE_BASE_PATH=/Newmoon/Newmoon-Web/dist/
